# Python and test caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Build and packaging outputs.
build/
dist/
*.egg-info/

# Local environments, secrets, and auth/session state.
.env
.env.*
!.env.example
*.pem
*.key
*.token
.auth/
.playwright/
playwright/.auth/
storage-state*.json
browser-state/

# Local logs and temporary run outputs.
*.log
*.part
tmp/
temp/
HANDOFF.md

# Local CDISC standards and reference assets are licensed source materials.
